rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Pharmacies collection
    match /pharmacies/{pharmacyId} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2026, 10, 4);
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2026, 10, 4);
    }
    
    // Multi-tenant business collections
    match /{collectionName}/{docId} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2026, 10, 4);
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2026, 10, 4);
    }
  }
}
